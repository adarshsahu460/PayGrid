{
  "compilerOptions": {
    /* --- Core Settings --- */
    "target": "ES2022",                // Target modern JavaScript, supported by recent Node.js versions.
    "module": "NodeNext",               // Use the modern Node.js module system.
    "moduleResolution": "NodeNext",     // How modules get resolved, works with "module": "NodeNext".
    "lib": ["ES2022"],                  // Include modern ES features.

    /* --- Strictness & Code Quality --- */
    "strict": true,                     // Enable all strict type-checking options. THIS IS KEY.
    "noUnusedLocals": true,             // Report errors on unused local variables.
    "noUnusedParameters": true,         // Report errors on unused parameters.
    "noImplicitReturns": true,          // Report error when not all code paths in function return a value.
    "exactOptionalPropertyTypes": true, // Differentiates between a property that is `undefined` and one that is not present.

    /* --- Interoperability --- */
    "esModuleInterop": true,            // Allows default imports from modules with no default export (e.g., `import express from 'express'`).
    "forceConsistentCasingInFileNames": true, // Ensures file references are cased consistently. Prevents bugs on case-sensitive systems like Linux.

    /* --- Project Structure --- */
    "rootDir": "./src",                 // Specifies the root directory of input files.
    "outDir": "./dist",                 // Redirect output structure to the directory.
    "declaration": true,                // Generates corresponding '.d.ts' file for type definitions.

    /* --- Advanced --- */
    "skipLibCheck": true                // Skip type checking of declaration files from dependencies to speed up compilation.
  },
  "include": ["src/**/*"],              // Which files to include in the compilation.
  "exclude": ["node_modules", "dist"]   // Which files to exclude.
}